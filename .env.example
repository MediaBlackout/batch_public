# ============================================================================
# Batch Processing System - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit your .env file to version control!

# ----------------------------------------------------------------------------
# Required: OpenAI API Configuration
# ----------------------------------------------------------------------------
# Your OpenAI API key for batch processing
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ----------------------------------------------------------------------------
# Required: AWS Credentials
# ----------------------------------------------------------------------------
# AWS credentials for DynamoDB access
# Get your credentials from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# ----------------------------------------------------------------------------
# Optional: AWS Configuration
# ----------------------------------------------------------------------------
# AWS region for DynamoDB tables (default: us-east-1)
AWS_REGION=us-east-1

# DynamoDB table name for batch job bookkeeping (default: batchjob)
# This table stores metadata about submitted batches
# BATCHJOB_TABLE=batchjob

# ----------------------------------------------------------------------------
# Optional: System Prompt Override
# ----------------------------------------------------------------------------
# Override the default system prompt for all batches
# Note: You can also configure this in batch_config.json for per-table prompts
# BATCH_SYSTEM_PROMPT="You are an AI assistant..."

# ----------------------------------------------------------------------------
# Optional: Logging Configuration
# ----------------------------------------------------------------------------
# Set log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
# LOG_LEVEL=INFO
